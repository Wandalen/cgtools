#!/usr/bin/env bash
#@ purpose: Build and run any example crate by partial, case-insensitive match against its path.
#@ output:  Unique match: delegates to that example's own `verb/run` — `trunk serve --release`
#@          on a fresh random port with the browser auto-opened for browser examples (crate has
#@          an index.html), `cargo run --release --all-features` for native and offscreen
#@          examples (crate has a `.offscreen` marker: renders once to a file, no window —
#@          everything else is a live native window).
#@          No match or ambiguous match: lists candidates instead of guessing.
#@ param:   <query>   partial match against the crate's path relative to repo root, e.g.
#@                    `sun_grid` matches `examples/minwgpu/sun_grid_lines`. Two reserved
#@                    values instead of a real query: `list [tag]` prints every discoverable
#@                    example path, optionally filtered to those carrying `tag` (e.g.
#@                    `runtime:offscreen` or `api:wgpu` — see the `_TAGS` array below for the
#@                    full predefined set); `.` prints this help text.
set -euo pipefail

if [[ "${1:-}" == "." ]]
then
  printf '\n  %s\n\n' "$(basename "$0")"
  sed -n 's/^#@ /  /p' "$0"
  printf '\n'
  exit 0
fi

_SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
_REPO_ROOT="$( cd "$_SCRIPT_DIR/.." && pwd )"

# Predefined tag vocabulary (group:name). Each example may declare up to 3,
# via `[package.metadata.action]` / `tags = [...]` in its own Cargo.toml.
# Keep sorted within each group.
_TAGS=(
  api:webgl
  api:webgpu
  api:wgpu
  runtime:browser
  runtime:native
  runtime:offscreen
)

_tag_known()
{
  local _t
  for _t in "${_TAGS[@]}"
  do
    [[ "$_t" == "$1" ]] && return 0
  done
  return 1
}

# Discover every example crate: anything under examples/ (any depth) with
# its own Cargo.toml — module/helper crates like embroidery_tools are real
# products, not examples, so they're deliberately out of scope here.
# Classified as browser (has index.html, served via trunk), offscreen (has
# a .offscreen marker: renders once to a file and exits, no window opens),
# or native (everything else, built and run via plain cargo run) — no
# family names hardcoded, so new example directories are picked up
# automatically. Also reads each crate's declared tags (up to 3, from the
# predefined _TAGS set — unknown or excess tags warn to stderr but don't
# block discovery).
_discover()
{
  local _manifest _dir _rel _kind _tags_raw _tags _t _n
  while IFS= read -r -d '' _manifest
  do
    _dir="$( dirname "$_manifest" )"
    _rel="${_dir#"$_REPO_ROOT"/}"

    if [[ -f "$_dir/index.html" ]]
    then
      _kind="browser"
    elif [[ -f "$_dir/.offscreen" ]]
    then
      _kind="offscreen"
    else
      _kind="native"
    fi

    _tags_raw="$( sed -n -E 's/^tags = \[(.*)\]$/\1/p' "$_manifest" | tr -d '"' )"
    _tags=""
    _n=0
    if [[ -n "$_tags_raw" ]]
    then
      while IFS= read -r _t
      do
        _t="$( printf '%s' "$_t" | sed -E 's/^ +| +$//g' )"
        [[ -n "$_t" ]] || continue
        _n=$(( _n + 1 ))
        if ! _tag_known "$_t"
        then
          printf 'warning: %s declares unknown tag %q\n' "$_rel" "$_t" >&2
        fi
        _tags="${_tags:+$_tags,}$_t"
      done < <( printf '%s\n' "$_tags_raw" | tr ',' '\n' )
      if (( _n > 3 ))
      then
        printf 'warning: %s declares %d tags, max is 3\n' "$_rel" "$_n" >&2
      fi
    fi

    printf '%s|%s|%s\n' "$_rel" "$_kind" "$_tags"
  done < <(find "$_REPO_ROOT/examples" \( -name target -o -name .git \) -prune -o -name Cargo.toml -print0)
}

if [[ $# -eq 0 ]]
then
  printf 'error: missing query — pass a partial match against an example path, or "list"\n' >&2
  printf 'try: %s list\n' "$(basename "$0")" >&2
  exit 2
elif [[ $# -gt 2 ]] || { [[ $# -eq 2 ]] && [[ "$1" != "list" ]]; }
then
  printf 'error: unexpected arguments (a second argument is only valid after "list")\n' >&2
  exit 2
fi

_query="$1"

if [[ "$_query" == "list" ]]
then
  _tag_filter="${2:-}"
  _discover | sort | while IFS='|' read -r _p _k _t
  do
    if [[ -n "$_tag_filter" ]]
    then
      case ",$_t," in
        *",$_tag_filter,"*) ;;
        *) continue ;;
      esac
    fi
    printf '%-60s %-10s %s\n' "$_p" "$_k" "$_t"
  done
  exit 0
fi

_query_lc="${_query,,}"
_matches=()
while IFS= read -r _c
do
  _relpath="${_c%%|*}"
  if [[ "${_relpath,,}" == *"$_query_lc"* ]]
  then
    _matches+=( "$_c" )
  fi
done < <(_discover)

case "${#_matches[@]}" in
  0)
    printf 'error: no example matches %q\n' "$_query" >&2
    printf 'try: %s list\n' "$(basename "$0")" >&2
    exit 1
    ;;
  1)
    ;;
  *)
    printf 'error: ambiguous match %q — %d candidates:\n' "$_query" "${#_matches[@]}" >&2
    for _c in "${_matches[@]}"
    do
      printf '  %s\n' "${_c%%|*}" >&2
    done
    exit 1
    ;;
esac

_relpath="${_matches[0]%%|*}"
_absdir="$_REPO_ROOT/$_relpath"

if [[ ! -x "$_absdir/verb/run" ]]
then
  printf 'error: %s has no executable verb/run\n' "$_relpath" >&2
  exit 1
fi

printf 'running -> %s\n' "$_relpath" >&2
exec "$_absdir/verb/run"
