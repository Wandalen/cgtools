#!/usr/bin/env bash
#@ purpose: Run every cgtools_linter workspace-invariant check and report combined
#@          pass/fail — the sanctioned entry point for a full lint pass. See
#@          ../../linter/readme.md for the underlying cgtools_linter CLI this wraps.
#@ output:  Builds cgtools_linter once, then runs each registered lint individually via
#@          its own `lint::<id>` filter — the examples-gallery lints (action tags, lints
#@          inherit, workspace registration, asset path/reference checks, readme
#@          convention, gallery idempotence, dangling-link, readme-table-presence)
#@          scoped to examples/, and the workspace-wide lints (verb/run presence,
#@          browsee usage, verb-test coverage) scoped to the whole repo. Individual
#@          filtering (rather than one unfiltered pass per scope) is required because a
#@          lint checks every [package]-carrying crate under whatever target it's given
#@          with no path-based self-restriction — an unfiltered whole-repo pass would
#@          false-positive the examples-gallery lints against module/ crates that never
#@          carry `[package.metadata.action]` tags. Every lint runs to completion
#@          regardless of earlier failures; the script's own exit code is non-zero if any
#@          lint failed.
set -euo pipefail

if [[ "${1:-}" == "." ]]
then
  printf '\n  %s\n\n' "$(basename "$0")"
  sed -n 's/^#@ /  /p' "$0"
  printf '\n'
  exit 0
fi

_SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
_REPO_ROOT="$( cd "$_SCRIPT_DIR/.." && pwd )"
_LINTER_ROOT="$( cd "$_REPO_ROOT/../linter" && pwd )"

# id|scope pairs — scope "examples" targets examples/, scope "repo" targets the
# whole cgtools repo. See this script's own #@ output: above for why every lint
# is invoked individually rather than folded into one unfiltered pass per scope.
_LINTS=(
  "dangling-link|examples"
  "readme-table-presence|examples"
  "action-tags|examples"
  "lints-inherit|examples"
  "workspace-registration|examples"
  "asset-path-portability|examples"
  "asset-reference-integrity|examples"
  "no-unwrap-on-asset-load|examples"
  "offscreen-consistency|examples"
  "readme-convention|examples"
  "gallery-idempotent|examples"
  "verb-run|repo"
  "browsee-usage|repo"
  "verb-test-coverage|repo"
)

printf '=== building cgtools_linter ===\n'
( cd "$_LINTER_ROOT" && cargo build --bin cgtools_linter --quiet )

_checked=0
_failed=0
_failed_ids=()
for _entry in "${_LINTS[@]}"
do
  _id="${_entry%%|*}"
  _scope="${_entry#*|}"
  if [[ "$_scope" == "examples" ]]
  then
    _target="$_REPO_ROOT/examples"
    _target_label="examples/"
  else
    _target="$_REPO_ROOT"
    _target_label="."
  fi

  printf '=== lint: %s (target: %s) ===\n' "$_id" "$_target_label"
  if ( cd "$_LINTER_ROOT" && cargo run --bin cgtools_linter --quiet -- .lint "lint::$_id" "target::$_target" )
  then
    _checked=$(( _checked + 1 ))
  else
    _failed=$(( _failed + 1 ))
    _failed_ids+=( "$_id" )
  fi
done

printf 'lint: %d/%d passed\n' "$_checked" "$(( _checked + _failed ))"
if (( _failed > 0 ))
then
  printf 'failed: %s\n' "${_failed_ids[*]}" >&2
fi
(( _failed == 0 ))
